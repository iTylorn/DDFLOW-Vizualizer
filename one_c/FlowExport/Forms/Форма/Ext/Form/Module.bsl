&НаСервереБезКонтекста
Функция ВариантПеречисления(ИмяПеречисления, ИД, Синоним = "")
    Если ПустаяСтрока(ИД) И ПустаяСтрока(Синоним) Тогда
        Возврат Перечисления[ИмяПеречисления].ПустаяСсылка();
    КонецЕсли;
    Для Каждого Мета Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
        Если ИД = Мета.Имя Тогда
            Возврат Перечисления[ИмяПеречисления][Мета.Имя];
        КонецЕсли;
    КонецЦикла;
    Для Каждого Мета Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
        Значение = Перечисления[ИмяПеречисления][Мета.Имя];
        Если Синоним = Строка(Значение) Тогда Возврат Значение; КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "Не найдено значение 1С: " + ?(ПустаяСтрока(Синоним), ИД, Синоним);
КонецФункции

&НаСервереБезКонтекста
Функция НастройкиИсточника(СтрокаПакета, ТипОбеспечения)
    ТипИзФайла = ВариантПеречисления("Поток_ТипыОбеспечения", СтрокаПакета.provider_id, СтрокаПакета.provider_type);
    РКТ = ВариантПеречисления("Поток_АлгоритмРасписанияКонтрольнойТочки", СтрокаПакета.rkt_id, СтрокаПакета.rkt_algorithm);
    Если Не ЗначениеЗаполнено(ТипОбеспечения) Или Лев(ИмяПеречисления(РКТ), 7) = "УДАЛИТЬ" Тогда
        ВызватьИсключение "Выберите действующий тип обеспечения и алгоритм РКТ.";
    КонецЕсли;
    Типы = Перечисления.Поток_ТипыОбеспечения;
    Алгоритмы = Перечисления.Поток_АлгоритмРасписанияКонтрольнойТочки;
    РКТСнят = Ложь;
    Если ЗначениеЗаполнено(РКТ) Тогда
        ЭтоРасписаниеСборки = РКТ = Алгоритмы.ГрафикВыпускаПоСборкеРазборке;
        Если (ТипОбеспечения <> Типы.Производство И ТипОбеспечения <> Типы.СборкаРазборка)
            Или (ТипОбеспечения = Типы.СборкаРазборка) <> ЭтоРасписаниеСборки Тогда
            Если ТипОбеспечения = ТипИзФайла Тогда
                ВызватьИсключение "Алгоритм РКТ несовместим с типом передела в DD FLOW.";
            КонецЕсли;
            РКТ = Алгоритмы.ПустаяСсылка();
            РКТСнят = Истина;
        КонецЕсли;
    КонецЕсли;
    Если Метаданные.Перечисления.Поток_МакетПланаЗапуска.ЗначенияПеречисления.Найти(
        "ПоУмолчаниюДляТипаОбеспеченияПередела") = Неопределено Тогда
        Варианты = ВариантыПрежнейРедакции(ТипОбеспечения, РКТ);
    Иначе
        Регистр = РегистрыСведений.Поток_ПараметрыПеределов;
        КодТипа = КодТипаДляНастроек(ТипОбеспечения, РКТ);
        Варианты = Новый Структура("Макеты,Пакеты", Регистр.МакетыПеределов().Получить(КодТипа),
            Регистр.ПакетыДокументовПеределов().Получить(КодТипа));
    КонецЕсли;
    Результат = Новый Структура("Тип,РКТ,РКТСнят,Макеты,Пакеты,ПервыйПакет,Макет,Событие",
        ТипОбеспечения, РКТ, РКТСнят, Варианты.Макеты, Варианты.Пакеты,
        Варианты.Пакеты.ПакетыДокументов[0].ПакетДокументов,
        Перечисления.Поток_МакетПланаЗапуска.ПустаяСсылка(),
        Перечисления.Поток_СобытиеПослеФормированияПакетаДокументов.ОткрытьСтруктуруПодчиненности);
    Если ТипОбеспечения <> Типы.Покупка И ТипОбеспечения <> Типы.Промуслуги Тогда
        Макет = Метаданные.Перечисления.Поток_МакетПланаЗапуска.ЗначенияПеречисления.Найти(СтрокаПакета.layout_id);
        Если Макет <> Неопределено Тогда Результат.Макет = Перечисления.Поток_МакетПланаЗапуска[Макет.Имя]; КонецЕсли;
        Если Не ДопустимыйМакет(Результат, Результат.Макет) Тогда
            Результат.Макет = Результат.Макеты.МакетПоУмолчанию.Макет;
        КонецЕсли;
    КонецЕсли;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция КодТипаДляНастроек(ТипОбеспечения, РКТ)
    Регистр = РегистрыСведений.Поток_ПараметрыПеределов;
    Типы = Перечисления.Поток_ТипыОбеспечения;
    Если ТипОбеспечения = Типы.Покупка Тогда
        КодТипа = Регистр.ИДТипПеределаПокупка();
    ИначеЕсли ТипОбеспечения = Типы.Промуслуги Тогда
        КодТипа = Регистр.ИДТипПеределаПромуслуги();
    ИначеЕсли ТипОбеспечения = Типы.СборкаРазборка Тогда
        КодТипа = Регистр.ИДТипПеределаСборкаРазборка();
    ИначеЕсли ТипОбеспечения = Типы.Логистика Тогда
        КодТипа = Регистр.ИДТипПеределаЛогистика();
    ИначеЕсли Не ЗначениеЗаполнено(РКТ) Тогда
        КодТипа = Регистр.ИДТипПеределаПроизводствоБезРасписания();
    Иначе
        Алгоритмы = Перечисления.Поток_АлгоритмРасписанияКонтрольнойТочки;
        Если РКТ = Алгоритмы.ГрафикЗапускаПоПакетнойСпецификации Тогда
            КодТипа = Регистр.ИДПеределРасписаниеПакетнаяСпецификация();
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоНоменклатурам Тогда
            КодТипа = Регистр.ИДПеределГрафикВыпускаПоНоменклатурам();
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоНоменклатурамИОборудованию Тогда
            КодТипа = Регистр.ИДПеределГрафикВыпускаПоОборудованию();
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоСборкеРазборке Тогда
            КодТипа = Регистр.ИДПеределРасписаниеСборкаРазборка();
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоРасписаниюAPS Тогда
            КодТипа = Регистр.ИДПеределаРасписаниеAPS();
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоПлануПроизводства Тогда
            КодТипа = Регистр.ИДПеределРасписаниеПланПроизводства1С();
        Иначе
            КодТипа = Регистр.ИДТипПеределаПроизводствоСРасписанием();
        КонецЕсли;
    КонецЕсли;
    Возврат КодТипа;
КонецФункции

&НаСервереБезКонтекста
Функция ВариантыПрежнейРедакции(ТипОбеспечения, РКТ)
    // В ERP 2.5.20 штатная форма регистра не использует матрицу менеджера.
    // Для логистики, покупки и промуслуг форма очищает макет и алгоритм.
    Типы = Перечисления.Поток_ТипыОбеспечения;
    Алгоритмы = Перечисления.Поток_АлгоритмРасписанияКонтрольнойТочки;
    ИменаМакетов = "ПроизводствоБезГруппировки,ГруппировкаПоКодуПереналадки,ПроизводствоСГруппировкойНазначениям";
    Если ТипОбеспечения = Типы.Покупка Тогда
        ИменаПакетов = "ТипОбеспеченияПокупка,КорзинаЗаказов";
        ИменаМакетов = "";
    ИначеЕсли ТипОбеспечения = Типы.Промуслуги Тогда
        ИменаПакетов = "ТипОбеспеченияПромуслуги,КорзинаЗаказов";
        ИменаМакетов = "";
    ИначеЕсли ТипОбеспечения = Типы.Логистика Тогда
        ИменаПакетов = "ТипОбеспеченияЛогистика_СЦентральногоСклада,ТипОбеспеченияЛогистика_ОтгрузкаКлиентам,КорзинаЗаказов";
        ИменаМакетов = "";
    ИначеЕсли ТипОбеспечения = Типы.СборкаРазборка Тогда
        ИменаПакетов = "";
        ИменаМакетов = "ПроизводствоБезГруппировки";
    Иначе
        ИменаПакетов = "ТипОбеспеченияПроизводство,ТипОбеспеченияПроизводство_ПроизводствоБезЗаказа,"
            + "ТипОбеспеченияПроизводствоПередачаВКладовуюЭтапы,КорзинаЗаказов,"
            + "ТипОбеспеченияПроизводство_ПроизводствоБезЗаказаСЗаказомНаПеремещение";
        Если РКТ = Алгоритмы.ГрафикЗапускаПоПакетнойСпецификации Тогда
            ИменаМакетов = "РасписаниеКонтрольнойТочки";
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоНоменклатурам Тогда
            ИменаМакетов = "РасписаниеПланаВыпуска";
        ИначеЕсли РКТ = Алгоритмы.ГрафикВыпускаПоНоменклатурамИОборудованию Тогда
            ИменаМакетов = "ГрафикЗапускаПоНоменклатурам";
        ИначеЕсли ЗначениеЗаполнено(РКТ) Тогда
            ИменаМакетов = "ПроизводствоБезГруппировки";
        КонецЕсли;
    КонецЕсли;
    Макеты = Новый Массив;
    Для Каждого Имя Из СтрРазделить(ИменаМакетов, ",", Истина) Цикл
        Макеты.Добавить(Новый Структура("Макет", ВариантПеречисления("Поток_МакетПланаЗапуска", Имя)));
    КонецЦикла;
    Если Макеты.Количество() = 0 Тогда
        Макеты.Добавить(Новый Структура("Макет", Перечисления.Поток_МакетПланаЗапуска.ПустаяСсылка()));
    КонецЕсли;
    Пакеты = Новый Массив;
    Для Каждого Имя Из СтрРазделить(ИменаПакетов, ",", Истина) Цикл
        Пакеты.Добавить(Новый Структура("ПакетДокументов",
            ВариантПеречисления("Поток_ВариантыПакетовДокументовПриЗапуске", Имя)));
    КонецЦикла;
    Если Пакеты.Количество() = 0 Тогда
        Пакеты.Добавить(Новый Структура("ПакетДокументов", Перечисления.Поток_ВариантыПакетовДокументовПриЗапуске.ПустаяСсылка()));
    КонецЕсли;
    Возврат Новый Структура("Макеты,Пакеты",
        Новый Структура("Макеты,МакетПоУмолчанию", Макеты, Макеты[0]),
        Новый Структура("ПакетыДокументов,ПакетДокументовПоУмолчанию", Пакеты, Пакеты[0]));
КонецФункции

&НаСервереБезКонтекста
Функция РейтингДоступен(Рейтинги, Номер, Алгоритм, Цель = Неопределено)
    Для Каждого Занятый Из Рейтинги.НайтиСтроки(Новый Структура("Рейтинг", Номер)) Цикл
        Если Занятый.Передел <> Цель И Занятый.РКТ <> Алгоритм Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;
КонецФункции

&НаСервереБезКонтекста
Процедура НазначитьРейтингиПоКарте(ПеределыРКТ, Рейтинги)
    Индекс = ПеределыРКТ.Количество() - 1;
    Номер = 1;
    Пока Индекс >= 0 И Номер <= 999 Цикл
        ПеределРКТ = ПеределыРКТ[Индекс];
        Если РейтингДоступен(Рейтинги, Номер, ПеределРКТ.Алгоритм) Тогда
            ПеределРКТ.Строка.Рейтинг = Номер;
            Индекс = Индекс - 1;
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкиТипаНаСервере(Ключ)
    Если ПустаяСтрока(ЭтаФорма.АдресПакета) Тогда Возврат; КонецЕсли;
    Пакет = ПакетИзФайла(ЭтаФорма.АдресПакета);
    Для Каждого СтрокаПакета Из Пакет.stages Цикл
        Если СтрокаПакета.id <> Ключ Тогда Продолжить; КонецЕсли;
        Для Каждого СтрокаПередела Из ЭтаФорма.ПеределыКЗагрузке Цикл
            Если СтрокаПередела.Ключ <> Ключ Тогда Продолжить; КонецЕсли;
            Попытка
                Настройки = НастройкиИсточника(СтрокаПакета, СтрокаПередела.ТипПередела);
                СтрокаПередела.Макет = Настройки.Макет;
                СтрокаПередела.Пакет = Настройки.ПервыйПакет;
                Если Не ЗначениеЗаполнено(СтрокаПередела.Событие) Тогда СтрокаПередела.Событие = Настройки.Событие; КонецЕсли;
                Если Настройки.РКТСнят Тогда
                    ЭтаФорма.ОтчетПроверки = "РКТ несовместимо с выбранным типом и будет снято при записи. Нажмите «Предпросмотр».";
                КонецЕсли;
            Исключение
                ЭтаФорма.ОтчетПроверки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
            КонецПопытки;
            Возврат;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПакетыНаСервере()
    ЭтаФорма.АдресПроверки = "";
    Пакет = ПакетИзФайла(ЭтаФорма.АдресПакета);
    ПеределыПакета = Новый Соответствие;
    Для Каждого СтрокаПакета Из Пакет.stages Цикл
        ПеределыПакета.Вставить(СтрокаПакета.id, СтрокаПакета);
    КонецЦикла;
    Заполнено = 0;
    Ошибки = Новый Массив;
    Для Каждого СтрокаПередела Из ЭтаФорма.ПеределыКЗагрузке Цикл
        Если Не СтрокаПередела.Отмечен Тогда Продолжить; КонецЕсли;
        Попытка
            Настройки = НастройкиИсточника(ПеределыПакета.Получить(СтрокаПередела.Ключ), СтрокаПередела.ТипПередела);
            СтрокаПередела.Пакет = Настройки.ПервыйПакет;
            Заполнено = Заполнено + 1;
        Исключение
            Ошибки.Добавить("«" + СтрокаПередела.Название + "»: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;
    ЭтаФорма.ОтчетПроверки = "Пакет документов заполнен в строках: " + Строка(Заполнено) + ". Нажмите «Предпросмотр».";
    Если Ошибки.Количество() > 0 Тогда
        ЭтаФорма.ОтчетПроверки = ЭтаФорма.ОтчетПроверки + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДопустимыйМакет(Настройки, Значение)
    Типы = Перечисления.Поток_ТипыОбеспечения;
    Если Настройки.Тип = Типы.Покупка Или Настройки.Тип = Типы.Промуслуги Тогда
        Возврат Не ЗначениеЗаполнено(Значение);
    КонецЕсли;
    Для Каждого Вариант Из Настройки.Макеты.Макеты Цикл
        Если Вариант.Макет = Значение Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция ДопустимыйПакет(Настройки, Значение)
    Для Каждого Вариант Из Настройки.Пакеты.ПакетыДокументов Цикл
        Если Вариант.ПакетДокументов = Значение Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыПередела(Ссылка)
    Запись = РегистрыСведений.Поток_ПараметрыПеределов.СоздатьМенеджерЗаписи();
    Запись.Передел = Ссылка;
    Если ЗначениеЗаполнено(Ссылка) Тогда Запись.Прочитать(); КонецЕсли;
    Возврат Запись;
КонецФункции

&НаСервереБезКонтекста
Функция ЗанятыеРейтинги()
    Запрос = Новый Запрос("ВЫБРАТЬ РейтингСортировки КАК Рейтинг, АлгоритмРасписанияКонтрольнойТочки КАК РКТ, Передел
    | ИЗ РегистрСведений.Поток_ПараметрыПеределов
    | ГДЕ РейтингСортировки > 0
    | И АлгоритмРасписанияКонтрольнойТочки <> ЗНАЧЕНИЕ(Перечисление.Поток_АлгоритмРасписанияКонтрольнойТочки.ПустаяСсылка)");
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервере
Процедура ПодготовитьФорму(Адрес)
    Пакет = ПакетИзФайла(Адрес);
    ЭтаФорма.АдресПакета = "";
    ЭтаФорма.АдресПроверки = "";
    ЭтаФорма.ПеределыКЗагрузке.Очистить();
    ЭтаФорма.СкладыКЗагрузке.Очистить();
    ЭтаФорма.ПапкиКЗагрузке.Очистить();
    ПрошлыеЦели = Новый Соответствие;
    Для Каждого ЗаписьКарты Из МеткиВыбраннойКарты(Пакет.map_id) Цикл
        Метка = ПрочитатьМетки(ЗаписьКарты.Описание).Получить(Пакет.map_id);
        Если ТипЗнч(Метка.Данные.snapshot) <> Тип("Структура") Тогда Продолжить; КонецЕсли;
        Для Каждого Привязка Из Метка.Данные.snapshot.bindings Цикл
            ПрошлыеЦели.Вставить(Привязка.source, Привязка.target);
        КонецЦикла;
    КонецЦикла;
    ИспользованныеСклады = Новый Соответствие;
    ИспользованныеПапки = Новый Соответствие;
    Для Каждого СтрокаПакета Из Пакет.stages Цикл
        Для Каждого Связь Из СтрокаПакета.inlets Цикл ИспользованныеСклады.Вставить(Связь.warehouse_id, Истина); КонецЦикла;
        Для Каждого Связь Из СтрокаПакета.stocks Цикл ИспользованныеСклады.Вставить(Связь.warehouse_id, Истина); КонецЦикла;
        ИспользованныеПапки.Вставить(СтрокаПакета.group_id, Истина);
    КонецЦикла;
    Сопоставление = Новый Соответствие;
    Для Каждого Склад Из Пакет.warehouses Цикл
        Если ИспользованныеСклады.Получить(Склад.id) = Неопределено Тогда Продолжить; КонецЕсли;
        ИспользованныеСклады.Удалить(Склад.id);
        СтрокаФормы = ЭтаФорма.СкладыКЗагрузке.Добавить();
        СтрокаФормы.Ключ = Склад.id;
        СтрокаФормы.Название = Склад.name;
        Ссылка = СсылкаПоИдентификатору("Склады", Склад.id);
        Если Ссылка = Неопределено Тогда
            Кандидаты = НайтиКандидатов("Склады", Склад.name);
            Если Кандидаты.Количество() = 1 Тогда Ссылка = Кандидаты[0]; КонецЕсли;
        КонецЕсли;
        Если Ссылка <> Неопределено И Не Ссылка.ЭтоГруппа Тогда
            СтрокаФормы.Цель = Ссылка;
            Сопоставление.Вставить(Склад.id, Ссылка);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Склад Из ИспользованныеСклады Цикл
        Если ПустаяСтрока(Склад.Ключ) Тогда Продолжить; КонецЕсли;
        СтрокаФормы = ЭтаФорма.СкладыКЗагрузке.Добавить();
        СтрокаФормы.Ключ = Склад.Ключ;
        СтрокаФормы.Название = "Склад из ссылки " + Склад.Ключ;
    КонецЦикла;
    Для Каждого Группа Из Пакет.groups Цикл
        Если ИспользованныеПапки.Получить(Группа.id) = Неопределено Тогда Продолжить; КонецЕсли;
        СтрокаФормы = ЭтаФорма.ПапкиКЗагрузке.Добавить();
        СтрокаФормы.Ключ = Группа.id;
        СтрокаФормы.Название = Группа.name;
        Ссылка = СсылкаПоИдентификатору("Поток_Переделы", Группа.id);
        Если Ссылка <> Неопределено И Ссылка.ЭтоГруппа Тогда СтрокаФормы.Цель = Ссылка; КонецЕсли;
    КонецЦикла;
    ПеределыРКТ = Новый Массив;
    Для Каждого СтрокаПакета Из Пакет.stages Цикл
        СтрокаФормы = ЭтаФорма.ПеределыКЗагрузке.Добавить();
        СтрокаФормы.Ключ = СтрокаПакета.id;
        СтрокаФормы.Название = СтрокаПакета.name;
        Ссылка = СсылкаПоИдентификатору("Поток_Переделы", СтрокаПакета.id);
        СтараяЦель = ПрошлыеЦели.Получить(СтрокаПакета.id);
        Если Ссылка = Неопределено И СтараяЦель <> Неопределено Тогда
            Ссылка = СсылкаПоИдентификатору("Поток_Переделы", СтараяЦель);
        КонецЕсли;
        Если Ссылка <> Неопределено И Ссылка.ЭтоГруппа Тогда Ссылка = Неопределено; КонецЕсли;
        Кандидаты = НайтиКандидатов("Поток_Переделы", СтрокаПакета.name);
        Если Ссылка = Неопределено И Кандидаты.Количество() = 1 Тогда Ссылка = Кандидаты[0]; КонецЕсли;
        Если Ссылка <> Неопределено Тогда СтрокаФормы.Цель = Ссылка; КонецЕсли;
        СтрокаФормы.НовыйПередел = Ссылка = Неопределено И Кандидаты.Количество() = 0;
        Если СтрокаФормы.НовыйПередел Тогда СтрокаФормы.Решение = "Создать"; КонецЕсли;
        Для Каждого Связь Из СтрокаПакета.inlets Цикл
            Если Связь.primary Или СтрокаПакета.inlets.Количество() = 1 Тогда
                Склад = Сопоставление.Получить(Связь.warehouse_id);
                Если Склад <> Неопределено Тогда СтрокаФормы.ОсновнойВход = Склад; КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Попытка
            СтрокаФормы.ТипПередела = ВариантПеречисления("Поток_ТипыОбеспечения", СтрокаПакета.provider_id, СтрокаПакета.provider_type);
            Настройки = НастройкиИсточника(СтрокаПакета, СтрокаФормы.ТипПередела);
            СтрокаФормы.Макет = Настройки.Макет;
            СтрокаФормы.Пакет = Настройки.ПервыйПакет;
            СтрокаФормы.Событие = Настройки.Событие;
            Если ЗначениеЗаполнено(Настройки.РКТ) Тогда
                ПеределыРКТ.Добавить(Новый Структура("Строка,Алгоритм", СтрокаФормы, Настройки.РКТ));
            КонецЕсли;
            Если ЗначениеЗаполнено(Ссылка) Тогда
                СохраненныеПараметрыПередела = ПараметрыПередела(Ссылка);
                Если ЗначениеЗаполнено(СохраненныеПараметрыПередела.СобытиеПослеФормированияПакетаДокументов) Тогда
                    СтрокаФормы.Событие = СохраненныеПараметрыПередела.СобытиеПослеФормированияПакетаДокументов;
                КонецЕсли;
            КонецЕсли;
        Исключение
            // The same validation runs in preview and reports the stage.
        КонецПопытки;
    КонецЦикла;
    НазначитьРейтингиПоКарте(ПеределыРКТ, ЗанятыеРейтинги());
    ЭтаФорма.АдресПакета = Адрес;
    ЭтаФорма.ОтчетПроверки = "Переделов в файле: " + Строка(ЭтаФорма.ПеределыКЗагрузке.Количество())
        + ". Проверьте сопоставление складов и решения для найденных переделов. Затем нажмите «Предпросмотр».";
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДействующаяСсылка(Ссылка, Папка = Ложь)
    Если Не ЗначениеЗаполнено(Ссылка) Тогда Возврат Ложь; КонецЕсли;
    ОбъектНСИ = Ссылка.ПолучитьОбъект();
    Возврат ОбъектНСИ <> Неопределено И Не ОбъектНСИ.ПометкаУдаления И ОбъектНСИ.ЭтоГруппа = Папка;
КонецФункции

&НаСервереБезКонтекста
Функция ДоступенТипДокументаВхода()
    Возврат Метаданные.Справочники.Поток_Переделы.ТабличныеЧасти.ВходнойСтеллаж.Реквизиты.Найти(
        "ТипДокументаОбеспеченияМатериалами") <> Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция СтрокиСкладов(СтрокиПакета, Склады, НазванияСкладов, ЭтоВход)
    Строки = Новый Массив;
    Основной = Справочники.Склады.ПустаяСсылка();
    ЕстьТипДокументаВхода = ЭтоВход И ДоступенТипДокументаВхода();
    Для Каждого Связь Из СтрокиПакета Цикл
        Если ПустаяСтрока(Связь.warehouse_id) Тогда
            Если Связь.primary Или Связь.ignore_on_launch
                Или Не ПустаяСтрока(Связь.parameter_id) Или Не ПустаяСтрока(Связь.parameter_name)
                Или Не ПустаяСтрока(Связь.material_doc_type_id)
                Или Не ПустаяСтрока(Связь.department_id) Или Не ПустаяСтрока(Связь.department_name) Тогда
                ВызватьИсключение "В файле есть строка с заполненными настройками без склада. Укажите склад в карте.";
            КонецЕсли;
            Продолжить;
        КонецЕсли;
        Склад = Склады.Получить(Связь.warehouse_id);
        Если Склад = Неопределено Тогда
            НазваниеСклада = НазванияСкладов.Получить(Связь.warehouse_id);
            Если НазваниеСклада = Неопределено Тогда НазваниеСклада = Связь.warehouse_id; КонецЕсли;
            ВызватьИсключение "На вкладке «Склады» выберите склад 1С для «" + НазваниеСклада + "» ("
                + ?(ЭтоВход, "входной стеллаж", "остатки в работе") + ").";
        КонецЕсли;
        Если Связь.primary Тогда
            Если ЗначениеЗаполнено(Основной) Тогда ВызватьИсключение "Выбрано несколько основных складов."; КонецЕсли;
            Основной = Склад;
        КонецЕсли;
        Если ЭтоВход Тогда
            Параметр = Неопределено;
            Если Не ПустаяСтрока(Связь.parameter_id) Или Не ПустаяСтрока(Связь.parameter_name) Тогда
                Если Связь.parameter_type = "ПеречислениеСсылка.Поток_ТипыОбеспечения" Тогда
                    Параметр = ВариантПеречисления("Поток_ТипыОбеспечения", Связь.parameter_id, Связь.parameter_name);
                ИначеЕсли Связь.parameter_type = "СправочникСсылка.ВидыНоменклатуры" Тогда
                    Параметр = СсылкаПоИдентификатору("ВидыНоменклатуры", Связь.parameter_id);
                ИначеЕсли Связь.parameter_type = "СправочникСсылка.Поток_Переделы" Тогда
                    Параметр = СсылкаПоИдентификатору("Поток_Переделы", Связь.parameter_id);
                КонецЕсли;
                Если Не ЗначениеЗаполнено(Параметр) Тогда
                    ВызватьИсключение "Не найден параметр определения склада «" + Связь.parameter_name + "».";
                КонецЕсли;
            КонецЕсли;
            Если Не ЕстьТипДокументаВхода И Не ПустаяСтрока(Связь.material_doc_type_id) Тогда
                ВызватьИсключение "В этой редакции DD FLOW у входного стеллажа нет типа документа обеспечения. "
                    + "Проверьте настройку для склада «" + Строка(Склад) + "».";
            КонецЕсли;
            Документ = ВариантПеречисления("Поток_АлгоритмОбеспеченияМатериалами", Связь.material_doc_type_id);
            Строки.Добавить(Новый Структура("Склад,Параметр,НеУчитывать,Документ", Склад, Параметр, Связь.ignore_on_launch, Документ));
        Иначе
            Подразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
            Если Не ПустаяСтрока(Связь.department_id) Или Не ПустаяСтрока(Связь.department_name) Тогда
                Подразделение = СсылкаПоИдентификатору("СтруктураПредприятия", Связь.department_id);
                Если Подразделение = Неопределено Тогда
                    Кандидаты = НайтиКандидатов("СтруктураПредприятия", Связь.department_name);
                    Если Кандидаты.Количество() = 1 Тогда Подразделение = Кандидаты[0]; КонецЕсли;
                КонецЕсли;
                Если Подразделение = Неопределено Тогда
                    ВызватьИсключение "Не найдено подразделение «" + Связь.department_name + "».";
                КонецЕсли;
            КонецЕсли;
            Строки.Добавить(Новый Структура("Склад,Подразделение", Склад, Подразделение));
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("Строки,Основной", Строки, Основной);
КонецФункции

&НаСервереБезКонтекста
Функция МассивСкладов(Строки, ТолькоЗаполненные = Ложь)
    Результат = Новый Массив;
    Для Каждого Связь Из Строки Цикл
        Если ТолькоЗаполненные И Не ЗначениеЗаполнено(Связь.Склад) Тогда Продолжить; КонецЕсли;
        Результат.Добавить(Связь.Склад);
    КонецЦикла;
    Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьСтеллажи(ТипОбеспечения, Входы, Кладовые)
    Типы = Перечисления.Поток_ТипыОбеспечения;
    СкладыВхода = МассивСкладов(Входы.Строки);
    СкладыКладовых = МассивСкладов(Кладовые.Строки);
    Для Каждого Склад Из СкладыВхода Цикл
        Если СкладыКладовых.Найти(Склад) <> Неопределено Тогда
            ВызватьИсключение "Склад «" + Строка(Склад) + "» есть в обеих таблицах.";
        КонецЕсли;
    КонецЦикла;
    Если ТипОбеспечения = Типы.Покупка И СкладыВхода.Количество() > 0 Тогда
        ВызватьИсключение "У передела «Покупка» входные стеллажи должны быть пустыми.";
    КонецЕсли;
    Если ТипОбеспечения <> Типы.Производство И ЗначениеЗаполнено(Кладовые.Основной) Тогда
        ВызватьИсключение "Основная цеховая кладовая доступна для производства.";
    КонецЕсли;
    Если ЗначениеЗаполнено(Входы.Основной) И СкладыВхода.Найти(Входы.Основной) = Неопределено Тогда
        ВызватьИсключение "Основной входной стеллаж должен входить в таблицу.";
    КонецЕсли;
    Если СкладыВхода.Количество() = 1 И Не ЗначениеЗаполнено(Входы.Основной) Тогда
        ВызватьИсключение "Выберите единственный входной стеллаж как основной.";
    КонецЕсли;
    Если СкладыВхода.Количество() < 2 Тогда Возврат; КонецЕсли;
    ЕстьПараметр = ЗначениеЗаполнено(Входы.Строки[0].Параметр);
    Если ЕстьПараметр = ЗначениеЗаполнено(Входы.Основной) Тогда
        ВызватьИсключение "Укажите основной стеллаж или параметры для всех строк.";
    КонецЕсли;
    Для Каждого Связь Из Входы.Строки Цикл
        Если ЕстьПараметр <> ЗначениеЗаполнено(Связь.Параметр)
            Или (ЕстьПараметр И ТипЗнч(Связь.Параметр) <> ТипЗнч(Входы.Строки[0].Параметр)) Тогда
            ВызватьИсключение "Все параметры входных стеллажей должны быть одного типа и заполнены во всех строках.";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСтрокуПредпросмотра(Отчет, Название, Значение, Было, ИмяСвойства)
    Представление = Строка(Значение);
    Если ПустаяСтрока(Представление) Тогда Представление = "не задано"; КонецЕсли;
    СтрокаОтчета = "    " + Название + " — " + Представление;
    Предыдущее = Неопределено;
    Если Было <> Неопределено И Было.Свойство(ИмяСвойства, Предыдущее) И Предыдущее <> Значение Тогда
        ПредставлениеДо = Строка(Предыдущее);
        СтрокаОтчета = СтрокаОтчета + " (было " + ?(ПустаяСтрока(ПредставлениеДо), "не задано", ПредставлениеДо) + ")";
    КонецЕсли;
    Отчет.Добавить(СтрокаОтчета);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьСкладыПредпросмотра(Отчет, Название, Склады, Было, ИмяСвойства)
    Отчет.Добавить("    " + Название + ?(Склады.Количество() = 0, " — нет", ""));
    Для Каждого Склад Из Склады Цикл
        Отчет.Добавить("        • " + Строка(Склад));
    КонецЦикла;
    ПрежниеСклады = Неопределено;
    Если Было <> Неопределено И Было.Свойство(ИмяСвойства, ПрежниеСклады)
        И ЗначениеВСтрокуВнутр(ПрежниеСклады) <> ЗначениеВСтрокуВнутр(Склады) Тогда
        Отчет.Добавить("        Было в 1С" + ?(ПрежниеСклады.Количество() = 0, " — нет", ""));
        Для Каждого Склад Из ПрежниеСклады Цикл
            Отчет.Добавить("            • " + Строка(Склад));
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьПеределВПредпросмотр(Отчет, Номер, СтрокаПлана, Путь)
    ЕстьЦель = ЗначениеЗаполнено(СтрокаПлана.Цель);
    Было = ?(ЕстьЦель, СтрокаПлана.Было, Неопределено);
    КодВОтчете = ?(ЕстьЦель, " [" + СтрокаПлана.Цель.Код + "]", "");
    Если Отчет.Количество() > 0 Тогда Отчет.Добавить(""); КонецЕсли;
    Отчет.Добавить(Строка(Номер) + ". " + СтрокаПлана.Решение + " «" + СтрокаПлана.Имя + "»" + КодВОтчете);
    Если ЕстьЦель И Было.Имя <> СтрокаПлана.Имя Тогда
        ДобавитьСтрокуПредпросмотра(Отчет, "Наименование", СтрокаПлана.Имя, Было, "Имя");
    КонецЕсли;
    ДобавитьСтрокуПредпросмотра(Отчет, "Тип передела", СтрокаПлана.Тип, Было, "Тип");
    ДобавитьСтрокуПредпросмотра(Отчет, "Папка", Путь, Было, "Папка");
    ДобавитьСтрокуПредпросмотра(Отчет, "РКТ", СтрокаПлана.РКТ, Было, "РКТ");
    ДобавитьСтрокуПредпросмотра(Отчет, "Рейтинг РКТ", СтрокаПлана.Рейтинг, Было, "Рейтинг");
    ДобавитьСтрокуПредпросмотра(Отчет, "Макет плана запуска", СтрокаПлана.Макет, Было, "Макет");
    ДобавитьСтрокуПредпросмотра(Отчет, "Пакет документов", СтрокаПлана.Пакет, Было, "Пакет");
    ДобавитьСтрокуПредпросмотра(Отчет, "Событие", СтрокаПлана.Событие, Было, "Событие");
    ДобавитьСтрокуПредпросмотра(Отчет, "Запуск с дефицитом", СтрокаПлана.Дефицит, Было, "Дефицит");
    Для Каждого НастройкаПечати Из СтрокаПлана.ОтключитьПечать Цикл
        Отчет.Добавить("    " + НастройкаПечати.Название + " → «Не печатать».");
    КонецЦикла;
    Отчет.Добавить("");
    Отчет.Добавить("    Склады");
    ДобавитьСкладыПредпросмотра(Отчет, "Входные стеллажи", МассивСкладов(СтрокаПлана.Входы.Строки), Было, "Входы");
    ДобавитьСтрокуПредпросмотра(Отчет, "Основной входной стеллаж", СтрокаПлана.Входы.Основной, Было, "ОсновнойВход");
    ДобавитьСкладыПредпросмотра(Отчет, "Склады остатков в работе", МассивСкладов(СтрокаПлана.Кладовые.Строки), Было, "Кладовые");
    ДобавитьСтрокуПредпросмотра(Отчет, "Основная цеховая кладовая", СтрокаПлана.Кладовые.Основной, Было, "ОсновнаяКладовая");
КонецПроцедуры

&НаСервереБезКонтекста
Функция СостояниеПараметров(Запись)
    Возврат Новый Структура("Макет,РКТ,Пакет,Рейтинг,Событие,Дефицит,Печать", Запись.МакетПланаЗапуска,
        Запись.АлгоритмРасписанияКонтрольнойТочки, Запись.ПакетДокументовПриЗапуске,
        Запись.РейтингСортировки, Запись.СобытиеПослеФормированияПакетаДокументов,
        Запись.РазрешитьЗапускПроизводстваПриНаличииДефицита, СостояниеПечатиПередела(Запись));
КонецФункции

&НаСервереБезКонтекста
Функция СостояниеПечатиПередела(Запись)
    Режимы = Новый Массив;
    Режимы.Добавить(Новый Структура("Поле,Название,Режим,Обработка,Принтер",
        "ПараметрыПечатиСменногоЗадания", "Печать сменного задания", Запись.ПараметрыПечатиСменногоЗадания,
        Запись.ИмяОбработкиПечатиСменногоЗадания, Запись.ИмяПринтераПечатиСменногоЗадания));
    РесурсыРегистра = Метаданные.РегистрыСведений.Поток_ПараметрыПеределов.Ресурсы;
    Если РесурсыРегистра.Найти("ПараметрыПечатиПослеВыпуска") <> Неопределено Тогда
        Режимы.Добавить(Новый Структура("Поле,Название,Режим,Обработка,Принтер",
            "ПараметрыПечатиПослеВыпуска", "Печать после выпуска", Запись.ПараметрыПечатиПослеВыпуска,
            Запись.ИмяОбработкиПечатиПослеВыпуска, Запись.ИмяПринтераПечатиПослеВыпуска));
    КонецЕсли;
    Возврат Режимы;
КонецФункции

&НаСервереБезКонтекста
Функция НенастроенныеРежимыПечати(Режимы)
    Варианты = Перечисления.Поток_ПараметрыПечатиСменногоЗаданияПередела;
    ОтключаемыеРежимы = Новый Массив;
    Для Каждого Настройка Из Режимы Цикл
        Если Не ЗначениеЗаполнено(Настройка.Режим) Или Настройка.Режим = Варианты.НеПечатать Тогда Продолжить; КонецЕсли;
        Если Не ЗначениеЗаполнено(Настройка.Обработка)
            Или (Настройка.Режим = Варианты.ОтправитьНаПринтерВНастройках И Не ЗначениеЗаполнено(Настройка.Принтер)) Тогда
            ОтключаемыеРежимы.Добавить(Новый Структура("Поле,Название", Настройка.Поле, Настройка.Название));
        КонецЕсли;
    КонецЦикла;
    Возврат ОтключаемыеРежимы;
КонецФункции

&НаСервереБезКонтекста
Функция МеткиВыбраннойКарты(ИДКарты)
    Старые = Новый Массив;
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Описание ИЗ Справочник.Поток_Переделы
    | ГДЕ НЕ ЭтоГруппа УПОРЯДОЧИТЬ ПО Ссылка");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Если СтрНайти(Выборка.Описание, "[[DD_FLOW_MAP:") = 0 Тогда Продолжить; КонецЕсли;
        Попытка
            Метки = ПрочитатьМетки(Выборка.Описание);
        Исключение
            ВызватьИсключение "Проверьте метки в описании передела «" + Строка(Выборка.Ссылка)
                + "». " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
        КонецПопытки;
        Если Метки.Получить(ИДКарты) <> Неопределено Тогда
            Старые.Добавить(Новый Структура("Ссылка,Описание", Выборка.Ссылка, Выборка.Описание));
        КонецЕсли;
    КонецЦикла;
    Возврат Старые;
КонецФункции

&НаСервере
Функция ПодготовитьПлан(Пакет, Ошибки, СтрокиОтчета)
    Склады = Новый Соответствие;
    НазванияСкладов = Новый Соответствие;
    СвязиСкладов = Новый Массив;
    Для Каждого СтрокаФормы Из ЭтаФорма.СкладыКЗагрузке Цикл
        НазванияСкладов.Вставить(СтрокаФормы.Ключ, СтрокаФормы.Название);
        Если Не ДействующаяСсылка(СтрокаФормы.Цель) Тогда
            Ошибки.Добавить("Выберите склад 1С для «" + СтрокаФормы.Название + "».");
        Иначе
            Склады.Вставить(СтрокаФормы.Ключ, СтрокаФормы.Цель);
            СвязиСкладов.Добавить(Новый Структура("source,target", СтрокаФормы.Ключ, Идентификатор(СтрокаФормы.Цель)));
        КонецЕсли;
    КонецЦикла;
    Папки = Новый Соответствие;
    ИменаПапок = Новый Соответствие;
    ЦелиПапок = Новый Соответствие;
    ПорядокПапок = Новый Массив;
    Если ЭтаФорма.ГруппыЗагрузки Тогда
        Для Каждого СтрокаФормы Из ЭтаФорма.ПапкиКЗагрузке Цикл
            Имя = СокрЛП(СтрокаФормы.Название);
            Цель = СтрокаФормы.Цель;
            Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 50 Тогда
                Ошибки.Добавить("Имя папки должно содержать от 1 до 50 символов: «" + Имя + "».");
            КонецЕсли;
            Если ЗначениеЗаполнено(Цель) Тогда
                Если Не ДействующаяСсылка(Цель, Истина) Или ЗначениеЗаполнено(Цель.Родитель) Тогда
                    Ошибки.Добавить("Выберите действующую папку верхнего уровня для «" + Имя + "».");
                КонецЕсли;
                Если ЦелиПапок.Получить(Цель) <> Неопределено Тогда
                    Ошибки.Добавить("Одну папку 1С нельзя назначить нескольким группам карты: «" + Имя + "».");
                КонецЕсли;
                ЦелиПапок.Вставить(Цель, Истина);
            ИначеЕсли НайтиКандидатов("Поток_Переделы", Имя, Истина).Количество() > 0
                Или ИменаПапок.Получить(НРег(Имя)) <> Неопределено Тогда
                Ошибки.Добавить("Папка «" + Имя + "» уже существует или повторяется. Укажите папку 1С явно.");
            КонецЕсли;
            ИменаПапок.Вставить(НРег(Имя), Истина);
            ДанныеПапки = Новый Структура("Ключ,Имя,Цель,ИмяЦели", СтрокаФормы.Ключ, Имя, Цель,
                ?(ЗначениеЗаполнено(Цель), Строка(Цель), ""));
            Папки.Вставить(ДанныеПапки.Ключ, ДанныеПапки);
            ПорядокПапок.Добавить(ДанныеПапки);
        КонецЦикла;
    КонецЕсли;
    Решения = Новый Соответствие;
    Для Каждого СтрокаФормы Из ЭтаФорма.ПеределыКЗагрузке Цикл Решения.Вставить(СтрокаФормы.Ключ, СтрокаФормы); КонецЦикла;
    Цели = Новый Соответствие;
    Имена = Новый Соответствие;
    Рейтинги = ЗанятыеРейтинги();
    Строки = Новый Массив;
    Номер = 0;
    Для Каждого СтрокаПакета Из Пакет.stages Цикл
        Номер = Номер + 1;
        Попытка
            Если Пакет.order[Номер - 1] <> СтрокаПакета.id Тогда ВызватьИсключение "Порядок файла нарушен."; КонецЕсли;
            Решение = Решения.Получить(СтрокаПакета.id);
            Если Решение = Неопределено Тогда ВызватьИсключение "Повторно откройте файл."; КонецЕсли;
            Если СтрокаПакета.dynamic Тогда ВызватьИсключение "Динамические переделы загружаются штатно в 1С."; КонецЕсли;
            РешениеСтроки = РешениеДляПередела(Решение, Решение.Решение);
            Если РешениеСтроки <> "Обновить" И РешениеСтроки <> "Копия" И РешениеСтроки <> "Создать" Тогда
                ВызватьИсключение "Укажите решение. Для совпадения в 1С выберите «Обновить» или «Копия».";
            КонецЕсли;
            Цель = ?(РешениеСтроки = "Обновить", Решение.Цель, Справочники.Поток_Переделы.ПустаяСсылка());
            Имя = СокрЛП(?(РешениеСтроки = "Копия", Решение.НовоеИмя, СтрокаПакета.name));
            Если РешениеСтроки = "Копия" И ПустаяСтрока(Имя) Тогда
                ВызватьИсключение "Введите новое имя копии.";
            КонецЕсли;
            Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 50 Тогда
                ВызватьИсключение "Введите имя от 1 до 50 символов.";
            КонецЕсли;
            Если Имена.Получить(НРег(Имя)) <> Неопределено Тогда ВызватьИсключение "Имя передела повторяется."; КонецЕсли;
            Имена.Вставить(НРег(Имя), Истина);
            Если РешениеСтроки = "Обновить" Тогда
                Если Не ДействующаяСсылка(Цель) Или Цель.ДинамическийПередел Тогда
                    ВызватьИсключение "Выберите доступный статический передел для обновления.";
                КонецЕсли;
                Если Цели.Получить(Цель) <> Неопределено Тогда ВызватьИсключение "Цель уже назначена другому переделу карты."; КонецЕсли;
                Цели.Вставить(Цель, Истина);
            ИначеЕсли РешениеСтроки = "Создать" Тогда
                СсылкаФайла = СсылкаПоИдентификатору("Поток_Переделы", СтрокаПакета.id);
                Если ЗначениеЗаполнено(Решение.Цель) Или СсылкаФайла <> Неопределено Тогда
                    ВызватьИсключение "Выберите «Обновить» или «Копия» для найденного передела.";
                КонецЕсли;
            КонецЕсли;
            Для Каждого Кандидат Из НайтиКандидатов("Поток_Переделы", Имя) Цикл
                Если Кандидат <> Цель Тогда ВызватьИсключение "Имя уже используется в 1С. Выберите совпадение или задайте другое имя копии."; КонецЕсли;
            КонецЦикла;
            Настройки = НастройкиИсточника(СтрокаПакета, Решение.ТипПередела);
            Если Не ДопустимыйМакет(Настройки, Решение.Макет) Тогда
                ВызватьИсключение "Выберите допустимый макет из вариантов DD FLOW, например «" + Строка(Настройки.Макет) + "».";
            КонецЕсли;
            Если Не ДопустимыйПакет(Настройки, Решение.Пакет) Тогда
                Пакеты = Новый Массив;
                Для Каждого Вариант Из Настройки.Пакеты.ПакетыДокументов Цикл Пакеты.Добавить(Строка(Вариант.ПакетДокументов)); КонецЦикла;
                ВызватьИсключение "Выберите пакет документов: " + СтрСоединить(Пакеты, " / ") + ".";
            КонецЕсли;
            Если Не ЗначениеЗаполнено(Решение.Событие) Тогда ВызватьИсключение "Укажите событие после формирования пакета."; КонецЕсли;
            Типы = Перечисления.Поток_ТипыОбеспечения;
            События = Перечисления.Поток_СобытиеПослеФормированияПакетаДокументов;
            Если (Настройки.Тип = Типы.Покупка Или Настройки.Тип = Типы.Промуслуги Или Настройки.Тип = Типы.Логистика)
                И (Решение.Событие = События.ОткрытьДиспетчированиеЭтапов
                    Или Решение.Событие = События.ОткрытьФормированиеСменныхЗаданий) Тогда
                ВызватьИсключение "Для этого типа выберите текстовое сообщение или открытие структуры подчиненности.";
            КонецЕсли;
            Если ЗначениеЗаполнено(Настройки.РКТ) Тогда
                Если Решение.Рейтинг < 1 Или Решение.Рейтинг > 999 Или Цел(Решение.Рейтинг) <> Решение.Рейтинг Тогда
                    ВызватьИсключение "Для РКТ нужен целый рейтинг от 1 до 999.";
                КонецЕсли;
                Если Не РейтингДоступен(Рейтинги, Решение.Рейтинг, Настройки.РКТ,
                    ?(ЗначениеЗаполнено(Цель), Цель, Неопределено)) Тогда
                    ВызватьИсключение "Рейтинг занят другим алгоритмом РКТ.";
                КонецЕсли;
                Регистрация = Рейтинги.Добавить();
                Регистрация.Рейтинг = Решение.Рейтинг;
                Регистрация.Передел = Цель;
                Регистрация.РКТ = Настройки.РКТ;
            КонецЕсли;
            Входы = СтрокиСкладов(СтрокаПакета.inlets, Склады, НазванияСкладов, Истина);
            Если ЗначениеЗаполнено(Решение.ОсновнойВход) Тогда
                Входы.Основной = Решение.ОсновнойВход;
            ИначеЕсли Входы.Строки.Количество() = 1 Тогда
                Входы.Основной = Входы.Строки[0].Склад;
            КонецЕсли;
            Кладовые = СтрокиСкладов(СтрокаПакета.stocks, Склады, НазванияСкладов, Ложь);
            ПроверитьСтеллажи(Настройки.Тип, Входы, Кладовые);
            КлючПапки = ?(ЭтаФорма.ГруппыЗагрузки, СтрокаПакета.group_id, "");
            Папка = Папки.Получить(КлючПапки);
            Если Не ПустаяСтрока(КлючПапки) И Папка = Неопределено Тогда ВызватьИсключение "Не найдена группа передела."; КонецЕсли;
            СохраненныеПараметрыПередела = ПараметрыПередела(Цель);
            Было = СостояниеПараметров(СохраненныеПараметрыПередела);
            ОтключаемыеРежимыПечати = НенастроенныеРежимыПечати(Было.Печать);
            Если ЗначениеЗаполнено(Цель) Тогда
                Старый = Цель.ПолучитьОбъект();
                ПрочитатьМетки(Старый.Описание);
                Было.Вставить("Имя", Старый.Наименование);
                Было.Вставить("Тип", Старый.ТипОбеспечения);
                Было.Вставить("Папка", ?(ЗначениеЗаполнено(Старый.Родитель), Строка(Старый.Родитель), "корень"));
                Было.Вставить("Входы", МассивСкладов(Старый.ВходнойСтеллаж, Истина));
                Было.Вставить("ОсновнойВход", Старый.ОсновнойВходнойСтеллаж);
                Было.Вставить("Кладовые", МассивСкладов(Старый.ЦеховыеКладовые, Истина));
                Было.Вставить("ОсновнаяКладовая", Старый.ОсновнаяЦеховаяКладовая);
                Было.Вставить("Состояние", ЗначениеВСтрокуВнутр(Новый Структура("Имя,Код,Родитель,Тип,Описание,Основной,Основная,Входы,Кладовые",
                    Старый.Наименование, Старый.Код, Старый.Родитель, Старый.ТипОбеспечения, Старый.Описание,
                    Старый.ОсновнойВходнойСтеллаж, Старый.ОсновнаяЦеховаяКладовая,
                    Старый.ВходнойСтеллаж.Выгрузить(), Старый.ЦеховыеКладовые.Выгрузить())));
            КонецЕсли;
            СтрокаПлана = Новый Структура("Ключ,Имя,Цель,Решение,Группа,Тип,РКТ,Входы,Кладовые,Макет,Пакет,Рейтинг,Событие,Дефицит,Позиции,Было,ОтключитьПечать",
                СтрокаПакета.id, Имя, Цель, РешениеСтроки, КлючПапки, Настройки.Тип, Настройки.РКТ, Входы, Кладовые,
                Решение.Макет, Решение.Пакет, Решение.Рейтинг, Решение.Событие, СтрокаПакета.deficit_launch,
                СтрокаПакета.positions, Было, ОтключаемыеРежимыПечати);
            Строки.Добавить(СтрокаПлана);
            Путь = "корень";
            Если Папка <> Неопределено Тогда Путь = ?(ПустаяСтрока(Папка.ИмяЦели), Папка.Имя + " (создать папку)", Папка.ИмяЦели); КонецЕсли;
            ДобавитьПеределВПредпросмотр(СтрокиОтчета, Номер, СтрокаПлана, Путь);
            Если Настройки.РКТСнят Тогда
                СтрокиОтчета.Добавить("    Исходное РКТ будет снято, поскольку оно несовместимо с выбранным типом передела.");
            КонецЕсли;
            Если Не ПустаяСтрока(СтрокаПакета.layout_id) И СтрокаПакета.layout_id <> ИмяПеречисления(Решение.Макет) Тогда
                СтрокиОтчета.Добавить("    Исходный макет — " + СтрокаПакета.layout_id + ".");
            КонецЕсли;
        Исключение
            Ошибки.Добавить(Строка(Номер) + ". «" + СтрокаПакета.name + "»: "
                + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
        КонецПопытки;
    КонецЦикла;
    Если Номер <> Пакет.order.Количество() Тогда Ошибки.Добавить("Неверное количество строк порядка."); КонецЕсли;
    Старые = МеткиВыбраннойКарты(Пакет.map_id);
    Для Каждого Старая Из Старые Цикл
        Если Цели.Получить(Старая.Ссылка) = Неопределено Тогда
            СтрокиОтчета.Добавить("    Снять метку карты с «" + Строка(Старая.Ссылка) + "».");
        КонецЕсли;
    КонецЦикла;
    Возврат Новый Структура("Строки,Папки,СвязиСкладов,Старые,СГруппами", Строки, ПорядокПапок, СвязиСкладов, Старые, ЭтаФорма.ГруппыЗагрузки);
КонецФункции

&НаСервере
Процедура ПроверитьНаСервере()
    ЭтаФорма.АдресПроверки = "";
    Пакет = ПакетИзФайла(ЭтаФорма.АдресПакета);
    Ошибки = Новый Массив;
    Отчет = Новый Массив;
    План = ПодготовитьПлан(Пакет, Ошибки, Отчет);
    Если Ошибки.Количество() = 0 Тогда
        ЭтаФорма.АдресПроверки = ПоместитьВоВременноеХранилище(ЗначениеВСтрокуВнутр(План), УникальныйИдентификатор);
        НачалоОтчета = "Готово к записи. Проверьте изменения и нажмите «Записать».";
    Иначе
        НачалоОтчета = "Исправьте замечания и повторите предпросмотр." + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
    КонецЕсли;
    ЭтаФорма.ОтчетПроверки = НачалоОтчета + Символы.ПС + Символы.ПС + СтрСоединить(Отчет, Символы.ПС);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСкладыПередела(ОбъектПередела, СтрокаПлана)
    ОбъектПередела.ВходнойСтеллаж.Очистить();
    ОбъектПередела.ЦеховыеКладовые.Очистить();
    ОбъектПередела.ОсновнойВходнойСтеллаж = СтрокаПлана.Входы.Основной;
    ОбъектПередела.ОсновнаяЦеховаяКладовая = СтрокаПлана.Кладовые.Основной;
    ЕстьТипДокументаВхода = ДоступенТипДокументаВхода();
    Для Каждого Связь Из СтрокаПлана.Входы.Строки Цикл
        Новая = ОбъектПередела.ВходнойСтеллаж.Добавить();
        Новая.Склад = Связь.Склад;
        Если Связь.Параметр <> Неопределено Тогда Новая.ПараметрДляОпределенияСклада = Связь.Параметр; КонецЕсли;
        Новая.НеУчитыватьПриЗапуске = Связь.НеУчитывать;
        Если ЕстьТипДокументаВхода Тогда Новая.ТипДокументаОбеспеченияМатериалами = Связь.Документ; КонецЕсли;
    КонецЦикла;
    Для Каждого Связь Из СтрокаПлана.Кладовые.Строки Цикл
        Новая = ОбъектПередела.ЦеховыеКладовые.Добавить();
        Новая.Склад = Связь.Склад;
        Новая.Подразделение = Связь.Подразделение;
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаписатьПараметры(Ссылка, СтрокаПлана)
    Запись = ПараметрыПередела(Ссылка);
    Запись.Передел = Ссылка;
    Запись.МакетПланаЗапуска = СтрокаПлана.Макет;
    Запись.АлгоритмРасписанияКонтрольнойТочки = СтрокаПлана.РКТ;
    Запись.ПакетДокументовПриЗапуске = СтрокаПлана.Пакет;
    Запись.СобытиеПослеФормированияПакетаДокументов = СтрокаПлана.Событие;
    Если ЗначениеЗаполнено(СтрокаПлана.РКТ) Тогда Запись.РейтингСортировки = СтрокаПлана.Рейтинг; КонецЕсли;
    Запись.РазрешитьЗапускПроизводстваПриНаличииДефицита = СтрокаПлана.Дефицит;
    Для Каждого НастройкаПечати Из СтрокаПлана.ОтключитьПечать Цикл
        Запись[НастройкаПечати.Поле] = Перечисления.Поток_ПараметрыПечатиСменногоЗаданияПередела.НеПечатать;
    КонецЦикла;
    Запись.Записать(Истина);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
    Если ПустаяСтрока(ЭтаФорма.АдресПроверки) Тогда ВызватьИсключение "Сначала получите успешный предпросмотр."; КонецЕсли;
    Ожидалось = ПолучитьИзВременногоХранилища(ЭтаФорма.АдресПроверки);
    ЭтаФорма.АдресПроверки = "";
    Пакет = ПакетИзФайла(ЭтаФорма.АдресПакета);
    ТекущийШаг = "Проверка плана";
    Результат = Новый Массив;
    БылоСообщений = ПолучитьСообщенияПользователю(Ложь).Количество();
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Справочник.Поток_Переделы").Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Добавить("РегистрСведений.Поток_ПараметрыПеределов").Режим = РежимБлокировкиДанных.Исключительный;
        Блокировка.Заблокировать();
        Ошибки = Новый Массив;
        План = ПодготовитьПлан(Пакет, Ошибки, Новый Массив);
        Если Ошибки.Количество() > 0 Тогда ВызватьИсключение СтрСоединить(Ошибки, Символы.ПС); КонецЕсли;
        Если Ожидалось <> ЗначениеВСтрокуВнутр(План) Тогда
            ВызватьИсключение "Данные или настройки изменились. Повторите предпросмотр.";
        КонецЕсли;
        Папки = Новый Соответствие;
        Для Каждого ДанныеПапки Из План.Папки Цикл
            ТекущийШаг = "Папка «" + ДанныеПапки.Имя + "»";
            Ссылка = ДанныеПапки.Цель;
            Если Не ЗначениеЗаполнено(Ссылка) Тогда
                Папка = Справочники.Поток_Переделы.СоздатьГруппу();
                Папка.Наименование = ДанныеПапки.Имя;
                Папка.Записать();
                Ссылка = Папка.Ссылка;
            КонецЕсли;
            Папки.Вставить(ДанныеПапки.Ключ, Ссылка);
        КонецЦикла;
        Связи = Новый Массив;
        Использованные = Новый Соответствие;
        Для Каждого СтрокаПлана Из План.Строки Цикл
            ТекущийШаг = "Передел «" + СтрокаПлана.Имя + "»";
            Если ЗначениеЗаполнено(СтрокаПлана.Цель) Тогда
                Передел = СтрокаПлана.Цель.ПолучитьОбъект();
            Иначе
                Передел = Справочники.Поток_Переделы.СоздатьЭлемент();
            КонецЕсли;
            Передел.Наименование = СтрокаПлана.Имя;
            Родитель = Папки.Получить(СтрокаПлана.Группа);
            Передел.Родитель = ?(Родитель = Неопределено, Справочники.Поток_Переделы.ПустаяСсылка(), Родитель);
            Передел.ТипОбеспечения = СтрокаПлана.Тип;
            ЗаполнитьСкладыПередела(Передел, СтрокаПлана);
            Передел.Записать();
            ТекущийШаг = ТекущийШаг + ", параметры";
            ЗаписатьПараметры(Передел.Ссылка, СтрокаПлана);
            Использованные.Вставить(Передел.Ссылка, Истина);
            Связи.Добавить(Новый Структура("source,target", СтрокаПлана.Ключ, Идентификатор(Передел.Ссылка)));
            Результат.Добавить(СтрокаПлана.Решение + ": " + Передел.Код + " «" + Передел.Наименование
                + "» / " + ?(ЗначениеЗаполнено(Передел.Родитель), Строка(Передел.Родитель), "корень"));
        КонецЦикла;
        Снимок = Новый Структура("title,project,bindings,warehouse_bindings,published_groups",
            Пакет.title, Пакет.project, Связи, План.СвязиСкладов, План.СГруппами);
        Для Индекс = 0 По План.Строки.Количество() - 1 Цикл
            Передел = СсылкаПоИдентификатору("Поток_Переделы", Связи[Индекс].target).ПолучитьОбъект();
            ТекущийШаг = "Описание «" + Передел.Наименование + "»";
            Позиции = План.Строки[Индекс].Позиции;
            Метка = Новый Структура("version,map_id,order,positions,snapshot", 1, Пакет.map_id, Индекс + 1,
                Позиции, ?(Индекс = 0, Снимок, Неопределено));
            Передел.Описание = ЗаменитьМетку(Передел.Описание, Пакет.map_id, Метка);
            Передел.Записать();
        КонецЦикла;
        Для Каждого Старая Из План.Старые Цикл
            Если Использованные.Получить(Старая.Ссылка) <> Неопределено Тогда Продолжить; КонецЕсли;
            Передел = Старая.Ссылка.ПолучитьОбъект();
            ТекущийШаг = "Снятие метки с «" + Передел.Наименование + "»";
            Передел.Описание = ЗаменитьМетку(Передел.Описание, Пакет.map_id, Неопределено);
            Передел.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОшибкаЗаписи = ИнформацияОбОшибке();
        ОтменитьТранзакцию();
        ЭтаФорма.ОтчетПроверки = "Пакет отменён. " + ТекущийШаг + ": " + КраткоеПредставлениеОшибки(ОшибкаЗаписи);
        СообщенияЗаписи = ПолучитьСообщенияПользователю(Ложь);
        Для ИндексСообщения = БылоСообщений По СообщенияЗаписи.Количество() - 1 Цикл
            ЭтаФорма.ОтчетПроверки = ЭтаФорма.ОтчетПроверки + Символы.ПС + СообщенияЗаписи[ИндексСообщения].Текст;
        КонецЦикла;
        Возврат;
    КонецПопытки;
    ЭтаФорма.ОтчетПроверки = "Пакет записан." + Символы.ПС + СтрСоединить(Результат, Символы.ПС);
    ЭтаФорма.АдресПакета = "";
КонецПроцедуры
