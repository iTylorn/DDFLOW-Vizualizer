&НаСервере
Функция СписокКартНаСервере()
    Результат = Новый Массив;
    Запрос = Новый Запрос("ВЫБРАТЬ Описание ИЗ Справочник.Поток_Переделы ГДЕ НЕ ЭтоГруппа И НЕ ПометкаУдаления");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Попытка
            Метки = ПрочитатьМетки(Выборка.Описание);
        Исключение
            Продолжить;
        КонецПопытки;
        Для Каждого Метка Из Метки Цикл
            Если ТипЗнч(Метка.Значение.Данные.snapshot) = Тип("Структура") Тогда
                Результат.Добавить(Новый Структура("map_id,title", Метка.Ключ, Метка.Значение.Данные.snapshot.title));
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции

