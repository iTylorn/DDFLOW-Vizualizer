&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Метаданные.Справочники.Найти("Поток_Переделы") = Неопределено
        Или Метаданные.РегистрыСведений.Найти("Поток_ПараметрыПеределов") = Неопределено Тогда
        ВызватьИсключение "Для обмена откройте базу ERP с конфигурацией DD FLOW. В этой базе нет переделов или их параметров.";
    КонецЕсли;
    АвтоЗаголовок = Ложь;
    Заголовок = "Обмен картой DD FLOW";
    ПанельОбмена = ДобавитьГруппу("ПанельОбмена", Неопределено);
    ПанельОбмена.РастягиватьПоГоризонтали = Истина;
    КомандыОбмена = ДобавитьГруппу("КомандыОбмена", ПанельОбмена, Ложь);
    КомандыОбмена.РастягиватьПоГоризонтали = Истина;
    ДобавитьЗаголовок("ЗаголовокВыгрузки", КомандыОбмена, "Выгрузить из 1С");
    Элементы.ЗаголовокВыгрузки.РастягиватьПоГоризонтали = Истина;
    Элементы.ЗаголовокВыгрузки.АвтоМаксимальнаяШирина = Ложь;
    КомандыВыгрузки = ДобавитьГруппу("КомандыВыгрузки", КомандыОбмена);
    КнопкиСправочника = ДобавитьГруппу("КнопкиСправочника", КомандыВыгрузки);
    ДобавитьЗаголовок("ЗаголовокСправочника", КнопкиСправочника, "Справочник");
    ДобавитьКнопку("Выгрузить", "В Excel", КнопкиСправочника,
        "Выгрузить справочник переделов, настройки и склады без расположения блоков, стрелок и оформления.");
    ДобавитьКнопку("ВыгрузитьJSON", "В JSON", КнопкиСправочника,
        "Выгрузить справочник для визуализатора без расположения блоков, стрелок и оформления.");
    ДобавитьКнопку("ВыгрузитьКартуJSON", "Выгрузить карту потока (JSON)", КомандыВыгрузки,
        "Выгрузить сохранённую схему с расположением блоков, стрелками и оформлением. Настройки переделов и склады берутся из 1С.");
    НастройкиВыгрузки = ДобавитьГруппу("НастройкиВыгрузки", КомандыОбмена);
    ДобавитьФлажок("ГруппыВыгрузки", "Выгружать группы", НастройкиВыгрузки);
    ДобавитьФлажок("ПоНаименованию", "Без позиций — по имени", НастройкиВыгрузки,
        "Сортировка переделов без позиций. Когда флажок снят, используется код передела.");
    ЭтаФорма.ГруппыВыгрузки = Истина;
    ДобавитьЗаголовок("ЗаголовокЗагрузки", КомандыОбмена, "Загрузить в 1С");
    КомандыЗагрузки = ДобавитьГруппу("КомандыЗагрузки", КомандыОбмена);
    ДобавитьКнопку("ОткрытьJSON", "Открыть JSON…", КомандыЗагрузки, "Открыть JSON обмена из визуализатора.");
    ДобавитьКнопку("Проверить", "Предпросмотр", КомандыЗагрузки, "Проверить настройки и показать изменения в отчёте справа.");
    ДобавитьКнопку("Применить", "Записать", КомандыЗагрузки, "Записать изменения после успешного предпросмотра.");
    ДобавитьФлажок("ГруппыЗагрузки", "Загружать группы", КомандыЗагрузки);
    Элементы.ФлажокГруппыЗагрузки.УстановитьДействие("ПриИзменении", "ИзмененыНастройкиЗагрузки");
    ДобавитьПоле("АдресПакета", "Строка");
    ДобавитьПоле("АдресПроверки", "Строка");
    ДобавитьПоле("ОтчетПроверки", "Строка");
    ГруппаОтчета = ДобавитьГруппу("ГруппаОтчета", ПанельОбмена, Ложь);
    ГруппаОтчета.РастягиватьПоГоризонтали = Истина;
    ДобавитьЗаголовок("ЗаголовокОтчета", ГруппаОтчета, "Результат предпросмотра / записи");
    ПолеОтчета = Элементы.Добавить("ПолеОтчетаПроверки", Тип("ПолеФормы"), ГруппаОтчета);
    ПолеОтчета.Вид = ВидПоляФормы.ПолеВвода;
    ПолеОтчета.ПутьКДанным = "ОтчетПроверки";
    ПолеОтчета.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
    ПолеОтчета.МногострочныйРежим = Истина;
    ПолеОтчета.ТолькоПросмотр = Истина;
    ПолеОтчета.Высота = 5;
    ПолеОтчета.АвтоМаксимальнаяВысота = Ложь;
    ПолеОтчета.МаксимальнаяВысота = 5;
    ПолеОтчета.РастягиватьПоВертикали = Ложь;
    ПолеОтчета.Ширина = 42;
    ПолеОтчета.АвтоМаксимальнаяШирина = Ложь;
    ПолеОтчета.МаксимальнаяШирина = 0;
    ПолеОтчета.РастягиватьПоГоризонтали = Истина;
    ЭтаФорма.ОтчетПроверки = "Откройте JSON, чтобы подготовить загрузку в 1С.";
    Страницы = Элементы.Добавить("РабочиеСтраницы", Тип("ГруппаФормы"));
    Страницы.Вид = ВидГруппыФормы.Страницы;
    Страницы.РастягиватьПоГоризонтали = Истина;
    Страницы.РастягиватьПоВертикали = Истина;
    Страницы.Высота = 1;
    СтраницаПеределов = ДобавитьСтраницу("СтраницаПеределов", "Переделы", Страницы);
    СтраницаСкладов = ДобавитьСтраницу("СтраницаСкладов", "Склады", Страницы);
    СтраницаПапок = ДобавитьСтраницу("СтраницаПапок", "Группы", Страницы);
    КомандыПеределов = ДобавитьГруппу("КомандыПеределов", СтраницаПеределов);
    ДобавитьКнопку("ВыбратьВсе", "Выбрать все", КомандыПеределов);
    ДобавитьКнопку("СнятьВсе", "Снять все", КомандыПеределов);
    ДобавитьКнопку("ЗаполнитьРешение", "Заполнить…", КомандыПеределов);
    Колонки = Новый Структура("Ключ,НовыйПередел,Отмечен,Название,ТипПередела,Решение,Цель,НовоеИмя,ОсновнойВход,Макет,Пакет,Рейтинг,Событие",
        "Строка","Булево","Булево","Строка","ПеречислениеСсылка.Поток_ТипыОбеспечения","Строка",
        "СправочникСсылка.Поток_Переделы","Строка","СправочникСсылка.Склады",
        "ПеречислениеСсылка.Поток_МакетПланаЗапуска","ПеречислениеСсылка.Поток_ВариантыПакетовДокументовПриЗапуске",
        "Число","ПеречислениеСсылка.Поток_СобытиеПослеФормированияПакетаДокументов");
    ДобавитьТаблицу("ПеределыКЗагрузке", "Переделы к загрузке в порядке карты", Колонки, СтраницаПеределов);
    Элементы.Переместить(Элементы.ЗаголовокПеределыКЗагрузке, КомандыПеределов, Элементы.КнопкаВыбратьВсе);
    Элементы.ПеределыКЗагрузкеТипПередела.Заголовок = "Тип передела";
    Элементы.ПеределыКЗагрузкеТипПередела.УстановитьДействие("ПриИзменении", "ТипПеределаИзменен");
    Элементы.ПеределыКЗагрузкеНовоеИмя.Заголовок = "Новое имя";
    Элементы.ПеределыКЗагрузкеОсновнойВход.Заголовок = "Основной вход";
    ПолеРешения = Элементы.ПеределыКЗагрузкеРешение;
    ПолеРешения.РежимВыбораИзСписка = Истина;
    Для Каждого Решение Из СтрРазделить("Создать,Обновить,Копия", ",") Цикл
        ПолеРешения.СписокВыбора.Добавить(Решение);
    КонецЦикла;
    ДобавитьТаблицу("СкладыКЗагрузке", "Сопоставление складов",
        Новый Структура("Ключ,Название,Цель", "Строка","Строка","СправочникСсылка.Склады"), СтраницаСкладов);
    ДобавитьТаблицу("ПапкиКЗагрузке", "Папки справочника для групп карты",
        Новый Структура("Ключ,Название,Цель", "Строка","Строка","СправочникСсылка.Поток_Переделы"), СтраницаПапок);
    Элементы.ПапкиКЗагрузкеЦель.Заголовок = "Папка 1С (пусто — создать)";
КонецПроцедуры

&НаСервере
Функция ДобавитьГруппу(Имя, Родитель, Горизонтально = Истина)
    Группа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
    Группа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
    Группа.Группировка = ?(Горизонтально, ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда,
        ГруппировкаПодчиненныхЭлементовФормы.Вертикальная);
    Группа.Отображение = ОтображениеОбычнойГруппы.Нет;
    Группа.ОтображатьЗаголовок = Ложь;
    Группа.РастягиватьПоВертикали = Ложь;
    Группа.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
    Группа.ГоризонтальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
    Возврат Группа;
КонецФункции

&НаСервере
Процедура ДобавитьЗаголовок(Имя, Родитель, Текст)
    Надпись = Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
    Надпись.Вид = ВидДекорацииФормы.Надпись;
    Надпись.Заголовок = Текст;
    Надпись.Шрифт = Новый Шрифт(, , Истина);
КонецПроцедуры

&НаСервере
Функция ДобавитьСтраницу(Имя, Заголовок, Страницы)
    Страница = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Страницы);
    Страница.Вид = ВидГруппыФормы.Страница;
    Страница.Заголовок = Заголовок;
    Страница.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
    Страница.РастягиватьПоВертикали = Истина;
    Страница.Высота = 1;
    Возврат Страница;
КонецФункции

&НаСервере
Процедура ДобавитьПоле(Имя, ИмяТипаПоля)
    Список = Новый Массив;
    Список.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов(ИмяТипаПоля)));
    ИзменитьРеквизиты(Список);
КонецПроцедуры

&НаСервере
Процедура ДобавитьФлажок(Имя, Заголовок, Родитель, Подсказка = "")
    ДобавитьПоле(Имя, "Булево");
    Поле = Элементы.Добавить("Флажок" + Имя, Тип("ПолеФормы"), Родитель);
    Поле.Вид = ВидПоляФормы.ПолеФлажка;
    Поле.ПутьКДанным = Имя;
    Поле.Заголовок = Заголовок;
    Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
    Поле.Подсказка = Подсказка;
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопку(Имя, Заголовок, Родитель, Подсказка = "")
    Команда = Команды.Добавить(Имя);
    Команда.Действие = Имя;
    Команда.Заголовок = Заголовок;
    Команда.Подсказка = Подсказка;
    Кнопка = Элементы.Добавить("Кнопка" + Имя, Тип("КнопкаФормы"), Родитель);
    Кнопка.ИмяКоманды = Имя;
КонецПроцедуры

&НаСервере
Процедура ДобавитьТаблицу(Имя, Заголовок, Колонки, Родитель)
    ДобавитьПоле(Имя, "ТаблицаЗначений");
    Список = Новый Массив;
    Для Каждого Колонка Из Колонки Цикл
        Список.Добавить(Новый РеквизитФормы(Колонка.Ключ, Новый ОписаниеТипов(Колонка.Значение), Имя, Колонка.Ключ));
    КонецЦикла;
    ИзменитьРеквизиты(Список);
    ДобавитьЗаголовок("Заголовок" + Имя, Родитель, Заголовок);
    Таблица = Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
    Таблица.ПутьКДанным = Имя;
    Таблица.Заголовок = Заголовок;
    Таблица.ИзменятьСоставСтрок = Ложь;
    Таблица.Высота = 5;
    Таблица.РастягиватьПоГоризонтали = Истина;
    Таблица.РастягиватьПоВертикали = Истина;
    Для Каждого Колонка Из Колонки Цикл
        Если Колонка.Ключ = "Ключ" Или Колонка.Ключ = "НовыйПередел" Тогда Продолжить; КонецЕсли;
        Поле = Элементы.Добавить(Имя + Колонка.Ключ, Тип("ПолеФормы"), Таблица);
        Поле.ПутьКДанным = Имя + "." + Колонка.Ключ;
        Если Колонка.Ключ = "Отмечен" Тогда
            Поле.Вид = ВидПоляФормы.ПолеФлажка;
            Поле.Заголовок = "Выбор";
            Продолжить;
        КонецЕсли;
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.Заголовок = Колонка.Ключ;
        Поле.ТолькоПросмотр = Колонка.Ключ = "Название";
        Если Не Поле.ТолькоПросмотр Тогда
            Поле.УстановитьДействие("ПриИзменении", "ИзмененыНастройкиЗагрузки");
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВсе(Команда)
    Для Каждого СтрокаПередела Из ЭтаФорма.ПеределыКЗагрузке Цикл
        СтрокаПередела.Отмечен = Истина;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсе(Команда)
    Для Каждого СтрокаПередела Из ЭтаФорма.ПеределыКЗагрузке Цикл
        СтрокаПередела.Отмечен = Ложь;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРешение(Команда)
    Если ПустаяСтрока(ЭтаФорма.АдресПакета) Тогда
        Сообщить("Сначала откройте JSON карты.");
        Возврат;
    КонецЕсли;
    Для Каждого СтрокаПередела Из ЭтаФорма.ПеределыКЗагрузке Цикл
        Если СтрокаПередела.Отмечен Тогда
            Список = Новый СписокЗначений;
            Список.Добавить("Обновить", "Обновить найденные, создать новые");
            Список.Добавить("Копия", "Создать копию");
            Список.Добавить("Создать", "Создать новый");
            Список.Добавить("ПервыйПакет", "Пакет документов — первый допустимый");
            ПоказатьВыборИзСписка(Новый ОписаниеОповещения("РешениеВыбрано", ЭтаФорма),
                Список, Элементы.КнопкаЗаполнитьРешение);
            Возврат;
        КонецЕсли;
    КонецЦикла;
    Сообщить("Отметьте переделы для заполнения.");
КонецПроцедуры

&НаКлиенте
Процедура РешениеВыбрано(Выбор, ДополнительныеПараметры) Экспорт
    Если Выбор = Неопределено Тогда Возврат; КонецЕсли;
    Если Выбор.Значение = "ПервыйПакет" Тогда
        ЗаполнитьПакетыНаСервере();
        Возврат;
    КонецЕсли;
    Заполнено = ЗаполнитьОтмеченныеРешения(ЭтаФорма.ПеределыКЗагрузке, Выбор.Значение);
    ЭтаФорма.АдресПроверки = "";
    ЭтаФорма.ОтчетПроверки = "Заполнено строк: " + Строка(Заполнено) + ". "
        + ?(Выбор.Значение = "Копия", "Укажите новые имена копий. ", "")
        + ?(Выбор.Значение = "Обновить", "Новые переделы будут созданы. ", "") + "Нажмите «Предпросмотр».";
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнитьОтмеченныеРешения(Переделы, Решение)
    Заполнено = 0;
    Для Каждого СтрокаПередела Из Переделы Цикл
        Если Не СтрокаПередела.Отмечен Тогда Продолжить; КонецЕсли;
        СтрокаПередела.Решение = РешениеДляПередела(СтрокаПередела, Решение);
        Заполнено = Заполнено + 1;
    КонецЦикла;
    Возврат Заполнено;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РешениеДляПередела(СтрокаПередела, Решение)
    Если Решение = "Обновить" И СтрокаПередела.НовыйПередел И Не ЗначениеЗаполнено(СтрокаПередела.Цель) Тогда
        Возврат "Создать";
    КонецЕсли;
    Возврат Решение;
КонецФункции

&НаКлиенте
Процедура ТипПеределаИзменен(Элемент)
    ИзмененыНастройкиЗагрузки(Элемент);
    СтрокаПередела = Элементы.ПеределыКЗагрузке.ТекущиеДанные;
    Если СтрокаПередела <> Неопределено Тогда
        ОбновитьНастройкиТипаНаСервере(СтрокаПередела.Ключ);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзмененыНастройкиЗагрузки(Элемент)
    Если ПустаяСтрока(ЭтаФорма.АдресПакета) Тогда Возврат; КонецЕсли;
    ЭтаФорма.АдресПроверки = "";
    ЭтаФорма.ОтчетПроверки = "Настройки изменены. Нажмите «Предпросмотр».";
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
    Попытка
        Адрес = СформироватьФайлНаСервере();
        ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов("Сохранить данные DD FLOW", Истина);
        НачатьПолучениеФайлаССервера(Адрес, "DD_FLOW_для_визуализатора.xlsx", ПараметрыДиалога);
        Сообщить("Выгружены данные, доступные текущему пользователю. Ограничения доступа могут скрывать часть данных.");
    Исключение
        Сообщить("Выгрузка не выполнена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
    КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СформироватьФайлНаСервере(Карта = "", JSONФайл = Ложь)
    Док = ?(JSONФайл, Новый Массив, Новый ТабличныйДокумент);
    ЕстьТипДокументаВхода = ДоступенТипДокументаВхода();
    Имена = СтрРазделить("kind,id,name,code,owner_id,warehouse_id,primary,level,provider_type,rkt_algorithm,department_id,department_name,extra_json", ",");
    Если Не JSONФайл Тогда
        Для Индекс = 0 По Имена.Количество() - 1 Цикл
            Док.Область(1, Индекс + 1).Текст = Имена[Индекс];
        КонецЦикла;
    КонецЕсли;
    Номер = 1;
    ВыгрузитьЗначенияПеречисления(Док, Номер, "Поток_ТипыОбеспечения", "provider_option");
    ВыгрузитьЗначенияПеречисления(Док, Номер, "Поток_АлгоритмРасписанияКонтрольнойТочки", "rkt_option");

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Ссылка, Наименование, ПометкаУдаления, ЦеховаяКладовая ИЗ Справочник.Склады ГДЕ НЕ ЭтоГруппа";
    Склады = Запрос.Выполнить().Выбрать();
    Пока Склады.Следующий() Цикл
        Поля = НоваяСтрока("warehouse");
        Поля.id = Идентификатор(Склады.Ссылка);
        Поля.name = Склады.Наименование;
        Поля.extra_json = JSONСтруктуры(Новый Структура("deletion_mark,workshop_storage", Склады.ПометкаУдаления, Склады.ЦеховаяКладовая));
        ЗаписатьСтроку(Док, Номер, Имена, Поля);
    КонецЦикла;

    Если ЭтаФорма.ГруппыВыгрузки Тогда
        Запрос.Текст = "ВЫБРАТЬ Ссылка, Наименование, Код ИЗ Справочник.Поток_Переделы
        | ГДЕ ЭтоГруппа И НЕ ПометкаУдаления";
        Папки = Запрос.Выполнить().Выбрать();
        Пока Папки.Следующий() Цикл
            Поля = НоваяСтрока("group");
            Поля.id = Идентификатор(Папки.Ссылка);
            Поля.name = Папки.Наименование;
            Поля.code = Папки.Код;
            Поля.extra_json = JSONСтруктуры(Новый Структура("catalog_folder", Истина));
            ЗаписатьСтроку(Док, Номер, Имена, Поля);
        КонецЦикла;
    КонецЕсли;

    // На форме «Подразделение производит продукцию» соответствует реквизиту
    // ПроизводственноеПодразделение справочника СтруктураПредприятия. Это
    // подразделения для групп схемы; принадлежность передела не выводим.
    Запрос.Текст = "ВЫБРАТЬ Ссылка, Наименование, Код, Родитель
    | ИЗ Справочник.СтруктураПредприятия
    | ГДЕ НЕ ПометкаУдаления И ПроизводственноеПодразделение";
    Подразделения = Запрос.Выполнить().Выбрать();
    Пока Подразделения.Следующий() Цикл
        Поля = НоваяСтрока("group");
        Поля.id = Идентификатор(Подразделения.Ссылка);
        Поля.name = Подразделения.Наименование;
        Поля.code = Подразделения.Код;
        Поля.extra_json = JSONСтруктуры(Новый Структура("parent_id", Идентификатор(Подразделения.Родитель)));
        ЗаписатьСтроку(Док, Номер, Имена, Поля);
    КонецЦикла;

    Запрос.Текст = "ВЫБРАТЬ Переделы.Ссылка КАК Ссылка, Переделы.Наименование КАК Наименование,
    | Переделы.Код КАК Код, Переделы.ТипОбеспечения КАК ТипОбеспечения,
    | Переделы.ДинамическийПередел КАК ДинамическийПередел, Переделы.ПометкаУдаления КАК ПометкаУдаления,
    | Переделы.ОсновнойВходнойСтеллаж КАК ОсновнойВходнойСтеллаж,
    | Переделы.ОсновнаяЦеховаяКладовая КАК ОсновнаяЦеховаяКладовая,
    | Переделы.Родитель КАК Родитель, Переделы.Описание КАК Описание,
    | Параметры.Передел КАК ПеределПараметров, Параметры.МакетПланаЗапуска КАК МакетПланаЗапуска,
    | Параметры.АлгоритмРасписанияКонтрольнойТочки КАК АлгоритмРКТ,
    | Параметры.РазрешитьЗапускПроизводстваПриНаличииДефицита КАК Дефицит
    | ИЗ Справочник.Поток_Переделы КАК Переделы
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Поток_ПараметрыПеределов КАК Параметры
    | ПО Переделы.Ссылка = Параметры.Передел
    | ГДЕ НЕ Переделы.ЭтоГруппа И НЕ Переделы.ПометкаУдаления";
    ТаблицаПеределов = Запрос.Выполнить().Выгрузить();
    ТаблицаПеределов.Колонки.Добавить("ПорядокКарты");
    Снимок = Неопределено;
    Примечания = Новый Массив;
    КУдалению = Новый Массив;
    Для Каждого Передел Из ТаблицаПеределов Цикл
        Передел.ПорядокКарты = 2147483647;
        Если ПустаяСтрока(Карта) Тогда Продолжить; КонецЕсли;
        Попытка
            Метки = ПрочитатьМетки(Передел.Описание);
        Исключение
            Примечания.Добавить("Метка на переделе «" + Передел.Наименование + "» повреждена. Позиция из нее не восстановлена.");
            Продолжить;
        КонецПопытки;
        Метка = Метки.Получить(Карта);
        Если Метка = Неопределено Тогда
            Если Метки.Количество() > 0 Тогда КУдалению.Добавить(Передел); КонецЕсли;
            Продолжить;
        КонецЕсли;
        Передел.ПорядокКарты = Метка.Данные.order;
        Если ТипЗнч(Метка.Данные.snapshot) = Тип("Структура") Тогда
            Если Снимок <> Неопределено Тогда ВызватьИсключение "У карты несколько снимков."; КонецЕсли;
            Снимок = Метка.Данные.snapshot;
        КонецЕсли;
    КонецЦикла;
    Для Каждого СтрокаТаблицы Из КУдалению Цикл
        ТаблицаПеределов.Удалить(СтрокаТаблицы);
    КонецЦикла;
    Если Не ПустаяСтрока(Карта) И Снимок = Неопределено Тогда
        ВызватьИсключение "Снимок этой карты не найден.";
    КонецЕсли;
    ТаблицаПеределов.Сортировать("ПорядокКарты, " + ?(ЭтаФорма.ПоНаименованию, "Наименование, Код", "Код, Наименование") + ", Ссылка");
    Для Каждого Переделы Из ТаблицаПеределов Цикл
        Алгоритм = Переделы.АлгоритмРКТ;
        Поля = НоваяСтрока("stage");
        Поля.id = Идентификатор(Переделы.Ссылка);
        Поля.name = Переделы.Наименование;
        Поля.code = Переделы.Код;
        Поля.provider_type = ПредставлениеЗначения(Переделы.ТипОбеспечения);
        Поля.rkt_algorithm = ПредставлениеЗначения(Алгоритм);
        СостояниеМакета = "missing";
        ИмяМакета = "";
        ПредставлениеМакета = "";
        Если Переделы.ПеределПараметров <> Null Тогда
            СостояниеМакета = "empty";
            Если ЗначениеЗаполнено(Переделы.МакетПланаЗапуска) Тогда
                СостояниеМакета = "value";
                ИмяМакета = ИмяПеречисления(Переделы.МакетПланаЗапуска);
                ПредставлениеМакета = ПредставлениеЗначения(Переделы.МакетПланаЗапуска);
            КонецЕсли;
        КонецЕсли;
        Доп = Новый Структура("provider_type_id,rkt_algorithm_id,dynamic,deletion_mark,launch_layout_state,launch_layout_id,launch_layout_name",
            ИмяПеречисления(Переделы.ТипОбеспечения), ИмяПеречисления(Алгоритм), Переделы.ДинамическийПередел, Переделы.ПометкаУдаления,
            СостояниеМакета, ИмяМакета, ПредставлениеМакета);
        Доп.Вставить("catalog_parent_id", ?(ЭтаФорма.ГруппыВыгрузки, Идентификатор(Переделы.Родитель), ""));
        Доп.Вставить("deficit_launch", Переделы.Дефицит = Истина);
        Поля.extra_json = JSONСтруктуры(Доп);
        ЗаписатьСтроку(Док, Номер, Имена, Поля);

        ОбъектПередела = Переделы.Ссылка.ПолучитьОбъект();
        НайденОсновнойВход = Ложь;
        Для Каждого Стр Из ОбъектПередела.ВходнойСтеллаж Цикл
            Поля = НоваяСтрока("inlet");
            Поля.owner_id = Идентификатор(Переделы.Ссылка);
            Поля.warehouse_id = Идентификатор(Стр.Склад);
            Поля.primary = ?(ЗначениеЗаполнено(Стр.Склад) И Стр.Склад = Переделы.ОсновнойВходнойСтеллаж, "1", "0");
            Если Поля.primary = "1" Тогда НайденОсновнойВход = Истина; КонецЕсли;
            Параметр = Стр.ПараметрДляОпределенияСклада;
            Доп = Новый Структура("parameter_type,parameter_id,parameter_name,ignore_on_launch,material_doc_type_id",
                ВидПараметраЭкспорта(Параметр), ИдентификаторПараметра(Параметр), ПредставлениеЗначения(Параметр),
                Стр.НеУчитыватьПриЗапуске,
                ?(ЕстьТипДокументаВхода, ИмяПеречисления(Стр.ТипДокументаОбеспеченияМатериалами), ""));
            Поля.extra_json = JSONСтруктуры(Доп);
            ЗаписатьСтроку(Док, Номер, Имена, Поля);
        КонецЦикла;
        Если ЗначениеЗаполнено(Переделы.ОсновнойВходнойСтеллаж) И Не НайденОсновнойВход Тогда
            Поля = НоваяСтрока("inlet");
            Поля.owner_id = Идентификатор(Переделы.Ссылка);
            Поля.warehouse_id = Идентификатор(Переделы.ОсновнойВходнойСтеллаж);
            Поля.primary = "1";
            Поля.extra_json = JSONСтруктуры(Новый Структура("main_only", Истина));
            ЗаписатьСтроку(Док, Номер, Имена, Поля);
        КонецЕсли;
        НайденаОсновнаяКладовая = Ложь;
        Для Каждого Стр Из ОбъектПередела.ЦеховыеКладовые Цикл
            Поля = НоваяСтрока("stock");
            Поля.owner_id = Идентификатор(Переделы.Ссылка);
            Поля.warehouse_id = Идентификатор(Стр.Склад);
            Поля.primary = ?(ЗначениеЗаполнено(Стр.Склад) И Стр.Склад = Переделы.ОсновнаяЦеховаяКладовая, "1", "0");
            Если Поля.primary = "1" Тогда НайденаОсновнаяКладовая = Истина; КонецЕсли;
            Поля.department_id = Идентификатор(Стр.Подразделение);
            Поля.department_name = ПредставлениеЗначения(Стр.Подразделение);
            ЗаписатьСтроку(Док, Номер, Имена, Поля);
        КонецЦикла;
        Если ЗначениеЗаполнено(Переделы.ОсновнаяЦеховаяКладовая) И Не НайденаОсновнаяКладовая Тогда
            Поля = НоваяСтрока("stock");
            Поля.owner_id = Идентификатор(Переделы.Ссылка);
            Поля.warehouse_id = Идентификатор(Переделы.ОсновнаяЦеховаяКладовая);
            Поля.primary = "1";
            Поля.extra_json = JSONСтруктуры(Новый Структура("main_only", Истина));
            ЗаписатьСтроку(Док, Номер, Имена, Поля);
        КонецЕсли;
    КонецЦикла;
    Если JSONФайл Тогда
        Результат = Новый Структура("format,version,map_id,snapshot,rows,include_groups,warnings",
            "dd-flow-map-export", 1, Карта, Снимок, Док, ЭтаФорма.ГруппыВыгрузки, Примечания);
        Возврат ПоместитьВоВременноеХранилище(ПолучитьДвоичныеДанныеИзСтроки(
            JSONСтруктуры(Результат), КодировкаТекста.UTF8, Ложь), УникальныйИдентификатор);
    КонецЕсли;
    Поток = Новый ПотокВПамяти;
    Док.Записать(Поток, ТипФайлаТабличногоДокумента.XLSX);
    Возврат ПоместитьВоВременноеХранилище(Поток.ЗакрытьИПолучитьДвоичныеДанные(), УникальныйИдентификатор);
КонецФункции

&НаСервереБезКонтекста
Процедура ВыгрузитьЗначенияПеречисления(Док, Номер, ИмяПеречисления, Вид)
    Мета = Метаданные.Перечисления[ИмяПеречисления];
    Для Каждого ЗначениеМета Из Мета.ЗначенияПеречисления Цикл
        Значение = ПредопределенноеЗначение("Перечисление." + ИмяПеречисления + "." + ЗначениеМета.Имя);
        Поля = НоваяСтрока(Вид);
        Поля.id = ЗначениеМета.Имя;
        Поля.name = Строка(Значение);
        ЗаписатьСтроку(Док, Номер, СтрРазделить("kind,id,name,code,owner_id,warehouse_id,primary,level,provider_type,rkt_algorithm,department_id,department_name,extra_json", ","), Поля);
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция НоваяСтрока(Вид)
    Поля = Новый Структура("kind,id,name,code,owner_id,warehouse_id,primary,level,provider_type,rkt_algorithm,department_id,department_name,extra_json",
        Вид, "", "", "", "", "", "", "", "", "", "", "", "");
    Возврат Поля;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСтроку(Док, Номер, Имена, Поля)
    Номер = Номер + 1;
    Если ТипЗнч(Док) = Тип("Массив") Тогда
        СтрокаJSON = Новый Массив;
        Для Каждого Имя Из Имена Цикл
            СтрокаJSON.Добавить(Строка(Поля[Имя]));
        КонецЦикла;
        Док.Добавить(СтрокаJSON);
        Возврат;
    КонецЕсли;
    Для Индекс = 0 По Имена.Количество() - 1 Цикл
        Док.Область(Номер, Индекс + 1).Текст = Строка(Поля[Имена[Индекс]]);
    КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция Идентификатор(Ссылка)
    Если ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Строка(Ссылка.УникальныйИдентификатор());
    КонецЕсли;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеЗначения(Значение)
    Если ЗначениеЗаполнено(Значение) Тогда Возврат Строка(Значение); КонецЕсли;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ИмяПеречисления(Значение)
    Если ЗначениеЗаполнено(Значение) Тогда Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(Значение); КонецЕсли;
    Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторПараметра(Значение)
    Если Не ЗначениеЗаполнено(Значение) Тогда Возврат ""; КонецЕсли;
    Если ТипЗнч(Значение) = Тип("ПеречислениеСсылка.Поток_ТипыОбеспечения") Тогда
        Возврат ИмяПеречисления(Значение);
    КонецЕсли;
    Возврат Идентификатор(Значение);
КонецФункции

&НаСервереБезКонтекста
Функция ВидПараметраЭкспорта(Значение)
    Если Не ЗначениеЗаполнено(Значение) Тогда Возврат ""; КонецЕсли;
    Для Каждого КодТипа Из СтрРазделить("ПеречислениеСсылка.Поток_ТипыОбеспечения,СправочникСсылка.ВидыНоменклатуры,СправочникСсылка.Поток_Переделы", ",") Цикл
        Если ТипЗнч(Значение) = Тип(КодТипа) Тогда Возврат КодТипа; КонецЕсли;
    КонецЦикла;
    Возврат Строка(ТипЗнч(Значение));
КонецФункции

&НаСервереБезКонтекста
Функция JSONСтруктуры(Значение)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Значение);
    Возврат Запись.Закрыть();
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеИзТекста(Текст)
    Чтение = Новый ЧтениеJSON;
    Чтение.УстановитьСтроку(Текст);
    Данные = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Данные;
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьМетки(Описание)
    Метки = Новый Соответствие;
    НачалоМетки = "[[DD_FLOW_MAP:";
    КонецМетки = ":DD_FLOW_MAP]]";
    Позиция = 1;
    Пока Истина Цикл
        Начало = СтрНайти(Описание, НачалоМетки, НаправлениеПоиска.СНачала, Позиция);
        Если Начало = 0 Тогда Прервать; КонецЕсли;
        ДанныеОт = Начало + СтрДлина(НачалоМетки);
        Конец = СтрНайти(Описание, КонецМетки, НаправлениеПоиска.СНачала, ДанныеОт);
        Если Конец = 0 Или Начало <= 1 Тогда ВызватьИсключение "Неполная метка DD_FLOW_MAP."; КонецЕсли;
        Если Сред(Описание, Начало - 1, 1) <> Символы.ПС Тогда
            ВызватьИсключение "Метка DD_FLOW_MAP должна быть на отдельной строке.";
        КонецЕсли;
        Данные = ДанныеИзТекста(ПолучитьСтрокуИзДвоичныхДанных(
            Base64Значение(Сред(Описание, ДанныеОт, Конец - ДанныеОт)), КодировкаТекста.UTF8));
        Если Данные.version <> 1 Или Не ЗначениеЗаполнено(Данные.map_id)
            Или ТипЗнч(Данные.order) <> Тип("Число") Или Данные.order < 1
            Или Метки.Получить(Данные.map_id) <> Неопределено Тогда
            ВызватьИсключение "Недопустимая или повторная метка DD_FLOW_MAP.";
        КонецЕсли;
        ИдентификаторКарты = Новый УникальныйИдентификатор(Данные.map_id);
        Позиция = Конец + СтрДлина(КонецМетки);
        Если Позиция <= СтрДлина(Описание) И Сред(Описание, Позиция, 1) <> Символы.ПС
            И Сред(Описание, Позиция, 1) <> Символы.ВК Тогда
            ВызватьИсключение "Неверная граница метки DD_FLOW_MAP.";
        КонецЕсли;
        Метки.Вставить(Данные.map_id, Новый Структура("Начало,После,Данные", Начало - 1, Позиция, Данные));
        Если Позиция > СтрДлина(Описание) Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Возврат Метки;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаменитьМетку(Описание, Карта, Данные)
    Метки = ПрочитатьМетки(Описание);
    Старая = Метки.Получить(Карта);
    Вставка = "";
    Если Данные <> Неопределено Тогда
        Код = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(JSONСтруктуры(Данные), КодировкаТекста.UTF8, Ложь));
        Код = СтрЗаменить(СтрЗаменить(Код, Символы.ПС, ""), Символы.ВК, "");
        Вставка = Символы.ПС + "[[DD_FLOW_MAP:" + Код + ":DD_FLOW_MAP]]";
    КонецЕсли;
    Если Старая = Неопределено Тогда Возврат Описание + Вставка; КонецЕсли;
    Возврат Лев(Описание, Старая.Начало - 1) + Вставка + Сред(Описание, Старая.После);
КонецФункции

&НаКлиенте
