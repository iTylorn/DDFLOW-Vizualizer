&НаСервереБезКонтекста
Функция ПакетИзФайла(Адрес)
    Если ПустаяСтрока(Адрес) Тогда ВызватьИсключение "Сначала откройте JSON карты."; КонецЕсли;
    Файл = ПолучитьИзВременногоХранилища(Адрес);
    Если Файл = Неопределено Тогда ВызватьИсключение "Откройте файл карты повторно."; КонецЕсли;
    Пакет = ДанныеИзТекста(ПолучитьСтрокуИзДвоичныхДанных(Файл, КодировкаТекста.UTF8));
    Если Пакет.format <> "dd-flow-map" Или Пакет.version <> 1 Или Пакет.stages.Количество() = 0 Тогда
        ВызватьИсключение "Нужен JSON обмена, выгруженный из визуализатора.";
    КонецЕсли;
    Карта = Новый УникальныйИдентификатор(Пакет.map_id);
    Возврат Пакет;
КонецФункции

&НаСервереБезКонтекста
Функция НайтиКандидатов(ИмяСправочника, Имя, Папка = Ложь)
    УсловиеГруппы = ?(Метаданные.Справочники[ИмяСправочника].Иерархический, " И ЭтоГруппа = &Группа", "");
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник." + ИмяСправочника
        + " ГДЕ Наименование = &Имя И НЕ ПометкаУдаления" + УсловиеГруппы);
    Запрос.УстановитьПараметр("Имя", Имя);
    Запрос.УстановитьПараметр("Группа", Папка);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
